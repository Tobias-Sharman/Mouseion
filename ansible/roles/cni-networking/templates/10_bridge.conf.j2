{
    "cniVersion": "1.0.0",
    "name": "bridge",
    "type": "bridge",
    "bridge": "cnio0",
    "isGateway": true,
    "ipMasq": true,
    "ipam": {
        "type": "host-local",
        "ranges": [
          [{"subnet": "{{ worker_pod_cidrs[ec2_tags.Name] }}"}]
        ],
        "routes": [{"dst": "0.0.0.0/0"}]
    }
}
