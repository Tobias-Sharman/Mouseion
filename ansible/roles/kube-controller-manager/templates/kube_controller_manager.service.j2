[Unit]
Description=Kubernetes Controller Manager
Documentation=https://github.com/kubernetes/kubernetes
After=network.target

[Service]
ExecStart={{ install_dir }}/kube-controller-manager \
  --bind-address=127.0.0.1 \
  --cluster-cidr={{ pod_cidr }} \
  --cluster-name={{ cluster_name }} \
  --cluster-signing-cert-file={{ kube_config_dir }}/kubernetes-ca.pem \
  --cluster-signing-key-file={{ kube_config_dir }}/kubernetes-ca-key.pem \
  --kubeconfig={{ kube_config_dir }}/kube-controller-manager.kubeconfig \
  --leader-elect=true \
  --root-ca-file={{ kube_config_dir }}/kubernetes-ca.pem \
  --service-account-private-key-file={{ kube_config_dir }}/service-account-key.pem \
  --service-cluster-ip-range={{ service_cluster_ip_range }} \
  --use-service-account-credentials=true \
  --v=2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
